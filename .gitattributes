# Program files merge id by id (SHARING.md §6, ters/src/merge-files.ts).
# git uses its own line merge until a clone says what `ters` runs:
#   git config merge.ters.driver "node ters/cli/ters.ts merge %O %A %B %P"
ters/examples/**/*.json merge=ters
ters/library/*.json merge=ters

# `git diff` on program files shows `ters diff` once a clone runs
# `node ters/cli/ters.ts git-setup` (DIFF.md "In git"); --no-ext-diff shows the JSON.
# Named by the file alone, so a program anywhere (compiler/gaps, a folder
# moved) has both drivers (I269); `ters git-setup` adds these where missing.
**/code.json diff=ters merge=ters
**/names.default.json diff=ters merge=ters
**/comments.json diff=ters merge=ters
**/signatures.json diff=ters merge=ters
