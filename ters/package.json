{
  "name": "ters",
  "private": true,
  "type": "module",
  "description": "AST-first language prototype: the program is a tree of IDs, everything else is a view",
  "bin": {
    "lab": "cli/lab.ts"
  },
  "scripts": {
    "demo": "node src/demo.ts",
    "test": "node --test test/*.test.ts",
    "affected": "node test/affected.ts",
    "build-editor": "node ../editor/build.ts",
    "smoke": "node ../editor/smoke.ts",
    "error-table": "node test/errors.test.ts --write",
    "ledger-table": "node test/ledger.test.ts --write",
    "smoke-shaders": "node ../editor/shaders-smoke.ts",
    "lang": "node src/lang/demo.ts",
    "numbers": "node src/lang/numbers-demo.ts",
    "lab": "node cli/lab.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@webgpu/types": "^0.1.60",
    "esbuild": "0.25.10",
    "happy-dom": "^20.14.6",
    "playwright-core": "^1.55.0",
    "typescript": "^5.8.3"
  }
}
