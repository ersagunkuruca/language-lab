"comments": {
"@2aiar8afn319fh7bau5sl2kph7": "A footer element with these children: the page's foot.",
"@3q8mujc97aan17hckjnu6i3pso": "Text that doesn't change. Text that does is text(() => …), which the page runs again when what it reads changes.",
"@61h9h3mibq2j89rke7qabkpj5f": "A h2 element with these children: a second-level heading.",
"@8kod789ahfo6gkb2v7kumcq5ha": "An element with these children, for a tag that has no function of its own here (main, nav, table, …). Each tag a function, as in Elm's Html module (prior art).",
"@9ss5tatebvii5phepq4jmomgj8": "A span element with these children: a run of text inside a line.",
"@bmrnod7gtmuqutjnvj4d80to51": "A ul element with these children: a list with bullets, whose items are li.",
"@e9vvoducd9bgqlgkj9p1edb0i3": "A style element holding these rules.",
"@h6i0vvhi69ob4bssmdps931ba9": "The items of a cell's list, each drawn by row and all put inside (ul, div, …). An item still there when the list changes keeps its row as it was; only new items get one. Solid's <For> (prior art).",
"@hceetsf59k9s2rera76i83sadd": "The same element in this class, for a style sheet's rules to select.",
"@i8arvnhs8f9kd9p6qrr7nhcmr7": "A section element with these children: a part of the page.",
"@iacj0hnlm91r1g6r07ocvn8miu": "A div with these children. To give it attributes, wrap it: styled, classed, with.",
"@ib490ftfre591tih3gqru7ltv7": "A p element with these children: a paragraph.",
"@jo1mpsdo1mhrcivsdsjq0f2t32": "A button with this label that runs then when it's clicked.",
"@kt1tnturii4kt1742ccoek7ah0": "An input field: it has attributes and no children.",
"@l1ibnd69fhv5j8j3reredg1ar1": "A style sheet rule: a selector and its declarations. A style sheet is a list of these, so it shows rule by rule instead of as one long text.",
"@m9d5acn2v8t0bh1rimhtdg79lk": "The same element with these attributes added after its own. Text and parts have no attributes, so they come back as they are.",
"@oe5va67fq068an1ud2uv59j9tq": "A h1 element with these children: the biggest heading.",
"@p5eu0tb81l5l38882aeudruhqb": "A strong element with these children: important text, usually bold.",
"@q3vcu2f2lgb6pdf562vvnbmu67": "A li element with these children: one item of a list.",
"@q8dlchcmqhc90frtqba0cmcmfo": "An attribute whose value doesn't change.",
"@rrc61bud51hgr319omhcik166b": "The texts with between between each two of them.",
"@sg2dc5ip1bo8tn0dr0smqos7d2": "A label element with these children: a label for a field.",
"@ti0p5j9oa4jcbnvhqluqqfupur": "The same element with this id.",
"@ujjlraa6njt25mtnsi76vrut35": "The same element with this inline style (CSS declarations, such as color: #777; margin: 0).",
"@urmvgd3e2dcctt7q85g15nql15": "Rules that apply only when the query holds, such as (prefers-color-scheme: dark).",
"@v4m3u10hkehjb5097mejohqi5p": "A length in pixels, from a Float64 or an Int."
},
