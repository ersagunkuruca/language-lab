"comments": {
"@0aq6ushk77hhkob9n97nh83ljs": "The same element with this inline style (CSS declarations, such as color: #777; margin: 0).",
"@1ob2i0drvc2sa0d90vqv9q8ufb": "A span element with these children: a run of text inside a line.",
"@ajibg05n7cqg279jv9qvi8djkm": "A ul element with these children: a list with bullets, whose items are li.",
"@bn5rjs0hq81tbjugaj8hqtmoac": "A h1 element with these children: the biggest heading.",
"@c8uq9nrumtn2lpjh3f1s90k45s": "An element with these children, for a tag that has no function of its own here (main, nav, table, …). Each tag a function, as in Elm's Html module (prior art).",
"@cq6cllm6hqqghrfvj4kajfdpo9": "A li element with these children: one item of a list.",
"@esqmk2h0slldl8m8hc2h80sldd": "The items of a cell's list, each drawn by row and all put inside (ul, div, …). An item still there when the list changes keeps its row as it was; only new items get one. Solid's <For> (prior art).",
"@g6gaiek2qjshfe0vkbtnvr7hd3": "A strong element with these children: important text, usually bold.",
"@g942jn855t96qse0treeccgkt4": "A div with these children. To give it attributes, wrap it: styled, classed, with.",
"@hlslo1dolbpgod6bbka379icg7": "A footer element with these children: the page's foot.",
"@j9p7c5d57su4rmjk7kk5ue6jkh": "The same element in this class, for a style sheet's rules to select.",
"@k43ro04eq8t0mfqf6mqrceqm89": "The same element with this id.",
"@k7pj2b3cf4gjt58l5fnacc3vca": "A label element with these children: a label for a field.",
"@kvn311vfqt81dumblkdaro9gp4": "A button with this label that runs then when it's clicked.",
"@l1ibnd69fhv5j8j3reredg1ar1": "A style sheet rule: a selector and its declarations. A style sheet is a list of these, so it shows rule by rule instead of as one long text.",
"@l3oe8dri67cvo3u88g99tgi844": "An attribute whose value doesn't change.",
"@n4s5j5vlpvrhe23io0ro6l0hjo": "A style element holding these rules.",
"@nhui28oru3ga6kpe0rqpiv3o61": "The same element with these attributes added after its own. Text and parts have no attributes, so they come back as they are.",
"@ntpgtfpd57s0mlqebtevkj8o4u": "A p element with these children: a paragraph.",
"@ouqo6o10b1kha65b24ffamplam": "Text that doesn't change. Text that does is text(() => …), which the page runs again when what it reads changes.",
"@p458djeveteqa4svoilc3br5je": "A h2 element with these children: a second-level heading.",
"@rrc61bud51hgr319omhcik166b": "The texts with between between each two of them.",
"@sn2c2misnf8i94nm0veg6uknmu": "An input field: it has attributes and no children.",
"@urmvgd3e2dcctt7q85g15nql15": "Rules that apply only when the query holds, such as (prefers-color-scheme: dark).",
"@v4m3u10hkehjb5097mejohqi5p": "A length in pixels, from a Float64 or an Int.",
"@v5actsejrgii7b4crck74pefk9": "A section element with these children: a part of the page."
},
