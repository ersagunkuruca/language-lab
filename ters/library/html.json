"comments": {
"@04b52rgrcljcmtbjj3p5v37edi": "A h1 element with these children: the biggest heading.",
"@0746t4mtogl93a8afojp5gt5a7": "A li element with these children: one item of a list.",
"@19ve3dsrhd84gppgsmddjeqts1": "The items of a cell's list, each drawn by row and all put inside (ul, div, …). An item still there when the list changes keeps its row as it was; only new items get one. Solid's <For> (prior art).",
"@4uveuppcmvunbp6j9psdqposop": "A label element with these children: a label for a field.",
"@699ovdomn3v561iifv705d201d": "The same element with this id.",
"@6fu6bn3e72am60mn6ssq4kdogt": "A footer element with these children: the page's foot.",
"@7bjgr1abngheh0nc6sjill6rf5": "A div with these children. To give it attributes, wrap it: styled, classed, with.",
"@9i75r533oonijil8r9pjqofqc2": "Text that doesn't change. Text that does is text(() => …), which the page runs again when what it reads changes.",
"@a4p1agagsg0cut816h29ee07h1": "A h2 element with these children: a second-level heading.",
"@bqcvtfkvrsa38h0857bgc3cvnp": "The same element with these attributes added after its own. Text and parts have no attributes, so they come back as they are.",
"@dsuta92cg3qjcmugspvfhu24uc": "The same element in this class, for a style sheet's rules to select.",
"@e9hcgkj2ojs764vuioaikgcftl": "An attribute whose value doesn't change.",
"@gi3ge00g04rfoqh3d4cggda306": "An element with these children, for a tag that has no function of its own here (main, nav, table, …). Each tag a function, as in Elm's Html module (prior art).",
"@gqo9gfgjnkqp477figi5odn6gk": "A strong element with these children: important text, usually bold.",
"@ik4slkqfg3g30uqif03bcr0h0i": "A span element with these children: a run of text inside a line.",
"@itiup59ttob43ov9licq3e2jf3": "A style element holding these rules.",
"@ivie0v0k42iv03ogbrfrui03rs": "The same element with this inline style (CSS declarations, such as color: #777; margin: 0).",
"@l1ibnd69fhv5j8j3reredg1ar1": "A style sheet rule: a selector and its declarations. A style sheet is a list of these, so it shows rule by rule instead of as one long text.",
"@livjp5mi2lb1sk4l685tjtucp9": "A section element with these children: a part of the page.",
"@meeusdfnnot1iu1i5db07pa8dj": "A ul element with these children: a list with bullets, whose items are li.",
"@r0fadq75f9grlopidmk1fj4bj8": "A button with this label that runs then when it's clicked.",
"@rrc61bud51hgr319omhcik166b": "The texts with between between each two of them.",
"@t3aa6ip3e60jidnkh4cdnq6f1d": "A p element with these children: a paragraph.",
"@urmvgd3e2dcctt7q85g15nql15": "Rules that apply only when the query holds, such as (prefers-color-scheme: dark).",
"@v4m3u10hkehjb5097mejohqi5p": "A length in pixels, from a Float64 or an Int.",
"@v9e503vmpe1u3e4doonbh4ph3p": "An input field: it has attributes and no children."
},
