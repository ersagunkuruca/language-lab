"comments": {
"@046n1bvi1e2na9m6b8u04doo93": "The same element with these attributes added after its own. Text and parts have no attributes, so they come back as they are.",
"@1ii7tjvq3q5tpmj12ehn4eb0re": "An element with these children, for a tag that has no function of its own here (main, nav, table, …). Each tag a function, as in Elm's Html module (prior art).",
"@2th2me5odnag46p66aaqppii8q": "The same element in this class, for a style sheet's rules to select.",
"@47v5q5uqic7skl85v7l3013q3b": "A div with these children. To give it attributes, wrap it: styled, classed, with.",
"@4mhjj7hpge1qto8oh2s2la2hbv": "A section element with these children: a part of the page.",
"@9t3t4jqatqg25kvunulj42jh6h": "A p element with these children: a paragraph.",
"@9vkuua51ul74mrrvkdcghlivlq": "An attribute whose value doesn't change.",
"@aid5bfr5s9a0l7aq9j4rj62fhe": "The same element with this id.",
"@b92pihn639k6gpmkdaumr7uqlb": "A style element holding these rules.",
"@banh1s1bssrvav4pq82afhjl8l": "A ul element with these children: a list with bullets, whose items are li.",
"@eji046gtu9djk3e24sstkm3d6i": "The items of a cell's list, each drawn by row and all put inside (ul, div, …). An item still there when the list changes keeps its row as it was; only new items get one. Solid's <For> (prior art).",
"@fe7gtj9uoo1pdo23c6p6br1jt7": "A li element with these children: one item of a list.",
"@hce2b2j03sbj33a3qioriuud3j": "A strong element with these children: important text, usually bold.",
"@hklptk814pg9u4ac83tpg2bhnh": "A label element with these children: a label for a field.",
"@hrsk9kc5h6s1626ue0m8mckr87": "A footer element with these children: the page's foot.",
"@ju7rtnhcpif256pqbhggn4h3u3": "A button with this label that runs then when it's clicked.",
"@l1ibnd69fhv5j8j3reredg1ar1": "A style sheet rule: a selector and its declarations. A style sheet is a list of these, so it shows rule by rule instead of as one long text.",
"@luqqu5rmjnognubb3sajb6a69o": "The same element with this inline style (CSS declarations, such as color: #777; margin: 0).",
"@nl6mka876lqolpj4qnhpeiheqh": "An input field: it has attributes and no children.",
"@nqgvhnp74ju2m2cmcl1kulmf48": "A h1 element with these children: the biggest heading.",
"@oa7l3siuhp5aiip7p44vjituq5": "A h2 element with these children: a second-level heading.",
"@p0lrmmhlkl54v1k32ei5h6l9vm": "A span element with these children: a run of text inside a line.",
"@rh2b8rm5eobddhip8oaam1g3a8": "Text that doesn't change. Text that does is text(() => …), which the page runs again when what it reads changes.",
"@rrc61bud51hgr319omhcik166b": "The texts with between between each two of them.",
"@urmvgd3e2dcctt7q85g15nql15": "Rules that apply only when the query holds, such as (prefers-color-scheme: dark).",
"@v4m3u10hkehjb5097mejohqi5p": "A length in pixels, from a Float64 or an Int."
},
