"comments": {
"@16dj6esmh0c6p34ji6re8ea4f5": "A div with these children. To give it attributes, wrap it: styled, classed, with.",
"@3a7usjftsh415s51h22vp7961h": "A p element with these children: a paragraph.",
"@3flamvo1l8ensuskhf21rke7vg": "A h2 element with these children: a second-level heading.",
"@3kuj66khsjb08kseghjqfne181": "A footer element with these children: the page's foot.",
"@3u69bcvbneb216kvroassg1hnu": "A span element with these children: a run of text inside a line.",
"@44faefm87hljnfdam3mu1d7gkm": "The same element with this inline style (CSS declarations, such as color: #777; margin: 0).",
"@4t8q12pv3dp47kaae8pd2t4ajc": "A section element with these children: a part of the page.",
"@63jdvi3q0vlodm78lphti31qfp": "The same element with these attributes added after its own. Text and parts have no attributes, so they come back as they are.",
"@760bklce9rmdjiu99av6mr13t3": "A strong element with these children: important text, usually bold.",
"@7nc91rj020q9l37klnjos41fdn": "Text that doesn't change. Text that does is text(() => …), which the page runs again when what it reads changes.",
"@93ji4u3shnthjfehmfhntfmpa9": "The same element in this class, for a style sheet's rules to select.",
"@akvkjcr55maljgeb23e9u9pqae": "A li element with these children: one item of a list.",
"@cf46g36lp70bseghal4fgn9755": "The items of a cell's list, each drawn by row and all put inside (ul, div, …). An item still there when the list changes keeps its row as it was; only new items get one. Solid's <For> (prior art).",
"@cioojkd84bnjesps3omn6irsiv": "A label element with these children: a label for a field.",
"@f1v61d5mafhr8b03pkg2vpeesu": "An element with these children, for a tag that has no function of its own here (main, nav, table, …). Each tag a function, as in Elm's Html module (prior art).",
"@k4uc2r03rcbspql8k3ncuib4bl": "A button with this label that runs then when it's clicked.",
"@l1ibnd69fhv5j8j3reredg1ar1": "A style sheet rule: a selector and its declarations. A style sheet is a list of these, so it shows rule by rule instead of as one long text.",
"@lvkt1c5ejdp6a5ce2t02njbbk5": "The same element with this id.",
"@mj5veui61k480mr1g8v8be6ibn": "A h1 element with these children: the biggest heading.",
"@oesqiptqmfs6u58lnjpk8p0lhj": "A style element holding these rules.",
"@ojfh95cl60b1kel8purcec39ub": "An attribute whose value doesn't change.",
"@r9eb8aubchanl4t14gtkjovhsg": "An input field: it has attributes and no children.",
"@rrc61bud51hgr319omhcik166b": "The texts with between between each two of them.",
"@sqvt907enroqt4qjrkpaku6gmf": "A ul element with these children: a list with bullets, whose items are li.",
"@urmvgd3e2dcctt7q85g15nql15": "Rules that apply only when the query holds, such as (prefers-color-scheme: dark).",
"@v4m3u10hkehjb5097mejohqi5p": "A length in pixels, from a Float64 or an Int."
},
