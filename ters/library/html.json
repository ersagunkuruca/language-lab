"comments": {
"@04ok02mcbo2nq9rhelaab8o600": "A h2 element with these children: a second-level heading.",
"@13sotsnt0q289pqviqpk3mot9m": "A div with these children. To give it attributes, wrap it: styled, classed, with.",
"@29dqepag5bcef5luqipcqlhje9": "Text that doesn't change. Text that does is text(() => …), which the page runs again when what it reads changes.",
"@7bv4s9ldvv7ot6n5s9a65eh3m1": "An input field: it has attributes and no children.",
"@896gi71qlc0ddavrbn8irro38l": "The same element with this inline style (CSS declarations, such as color: #777; margin: 0).",
"@de7rkhl53uvl0bupu4lph26jdg": "The same element with this id.",
"@dhg6l8jq6ir1k4s52bd8rsel1n": "A ul element with these children: a list with bullets, whose items are li.",
"@e838lq3k6rle1m26cfviteq4db": "The same element with these attributes added after its own. Text and parts have no attributes, so they come back as they are.",
"@ela5jfqq0t6iv8ou2vsh4339cp": "An attribute whose value doesn't change.",
"@f5roijkva55u1chdmotplsq4a5": "The same element in this class, for a style sheet's rules to select.",
"@f5t973vp76bmk54u8joll8eon0": "A footer element with these children: the page's foot.",
"@ghcj6560nbn0bqejgqblj2ij1g": "A strong element with these children: important text, usually bold.",
"@hd2qjgmnq60cpgocg15rmd7ghm": "An element with these children, for a tag that has no function of its own here (main, nav, table, …). Each tag a function, as in Elm's Html module (prior art).",
"@jsf5lv8249qv7618cdmboq4doc": "A span element with these children: a run of text inside a line.",
"@kajhaq3oiqhlbltsjeai8g1pb6": "A h1 element with these children: the biggest heading.",
"@kqscauocu7fs6lafrrl21gib24": "A li element with these children: one item of a list.",
"@l1ibnd69fhv5j8j3reredg1ar1": "A style sheet rule: a selector and its declarations. A style sheet is a list of these, so it shows rule by rule instead of as one long text.",
"@o9jodrpvpksavs022m3vls7g09": "A button with this label that runs then when it's clicked.",
"@or29ovk8spemcqqdug3s7i5unc": "A p element with these children: a paragraph.",
"@pqgbadq9nsqsa2oqo1t47j4gev": "A style element holding these rules.",
"@r3l47pnkets9mcjvf66rf3aefg": "The items of a cell's list, each drawn by row and all put inside (ul, div, …). An item still there when the list changes keeps its row as it was; only new items get one. Solid's <For> (prior art).",
"@rrc61bud51hgr319omhcik166b": "The texts with between between each two of them.",
"@rrt6taem3efcd1re0tsonlao8n": "A label element with these children: a label for a field.",
"@urmvgd3e2dcctt7q85g15nql15": "Rules that apply only when the query holds, such as (prefers-color-scheme: dark).",
"@v4m3u10hkehjb5097mejohqi5p": "A length in pixels, from a Float64 or an Int.",
"@vj3fei8u21imlalg296e868t5b": "A section element with these children: a part of the page."
},
