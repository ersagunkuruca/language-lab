"comments": {
"@1mpkng8lnesa6231p4s4re63hq": "An input field: it has attributes and no children.",
"@2qrvi5fhellurrjvv5qrrqobdq": "A div with these children. To give it attributes, wrap it: styled, classed, with.",
"@4kn95g33l0g5c9t9dhj89f1gdd": "Text that doesn't change. Text that does is text(() => …), which the page runs again when what it reads changes.",
"@520dq1mntsl3d2vktggd7p3j7v": "A ul element with these children: a list with bullets, whose items are li.",
"@5qputco78vf9jik984psi9k0l0": "A footer element with these children: the page's foot.",
"@5v0gvokqolp40rec9ir9nbfmva": "The same element with this inline style (CSS declarations, such as color: #777; margin: 0).",
"@6dq9pvfac60t80hu3e4gs51i05": "A span element with these children: a run of text inside a line.",
"@7gbtm67uejtv1hhgktpf661k9k": "The same element with this id.",
"@8r1l9fbahap1k84div5drcdnpr": "A h1 element with these children: the biggest heading.",
"@dm86aiumbc8opckkd4mibackuf": "The items of a cell's list, each drawn by row and all put inside (ul, div, …). An item still there when the list changes keeps its row as it was; only new items get one. Solid's <For> (prior art).",
"@fn6psbip9k9rlp9bru5hpdksca": "A h2 element with these children: a second-level heading.",
"@hd85q9sgj2dmv6lecknr8s0soh": "A label element with these children: a label for a field.",
"@i7qtvl4o6g2ikvte6pmo9oiuqp": "The same element with these attributes added after its own. Text and parts have no attributes, so they come back as they are.",
"@l1ibnd69fhv5j8j3reredg1ar1": "A style sheet rule: a selector and its declarations. A style sheet is a list of these, so it shows rule by rule instead of as one long text.",
"@louuma9je5jce10fe9mouo9459": "A style element holding these rules.",
"@plncko1pbco9aoa2fpc92rhofj": "A li element with these children: one item of a list.",
"@ppa754luhv529r1iv57mn1jolo": "A strong element with these children: important text, usually bold.",
"@q5b3cq1j2ohell611n9qf3v50g": "An attribute whose value doesn't change.",
"@rrc61bud51hgr319omhcik166b": "The texts with between between each two of them.",
"@s8eqjevr4c9neu2rkaag6vclue": "A section element with these children: a part of the page.",
"@sktbi9jtn442trq0qupau7cv3i": "A button with this label that runs then when it's clicked.",
"@snk76k9eavnop4qk3u43drsg0q": "A p element with these children: a paragraph.",
"@tobvvqia1jiqt3cbm388s5oap3": "An element with these children, for a tag that has no function of its own here (main, nav, table, …). Each tag a function, as in Elm's Html module (prior art).",
"@uo0qc8q9kgpd90tosrb924l2an": "The same element in this class, for a style sheet's rules to select.",
"@urmvgd3e2dcctt7q85g15nql15": "Rules that apply only when the query holds, such as (prefers-color-scheme: dark).",
"@v4m3u10hkehjb5097mejohqi5p": "A length in pixels, from a Float64 or an Int."
},
