"comments": {
"@1mgnmmppl9crdus6or82u5376q": "Text that doesn't change. Text that does is text(() => …), which the page runs again when what it reads changes.",
"@2v7r2umk0dmeula9puut00qjc0": "A style element holding these rules.",
"@31o0nnuj63f5ueoq8rnpl6pdd1": "A div with these children. To give it attributes, wrap it: styled, classed, with.",
"@6t0rlaqoouv9qauvmr19kb6h90": "An input field: it has attributes and no children.",
"@81lff6ei6qkgkjco75c5l4m9vr": "A p element with these children: a paragraph.",
"@8b3n3ua2fbh1ut12hlrlfd10hn": "A span element with these children: a run of text inside a line.",
"@9cdep3bmmpal15jvacq9h38quv": "An element with these children, for a tag that has no function of its own here (main, nav, table, …). Each tag a function, as in Elm's Html module (prior art).",
"@bs5031q8bv8o8g9b7r9o0fckpm": "A ul element with these children: a list with bullets, whose items are li.",
"@ch45l9sabsp6dejtgh5n2ah5ic": "The items of a cell's list, each drawn by row and all put inside (ul, div, …). An item still there when the list changes keeps its row as it was; only new items get one. Solid's <For> (prior art).",
"@d22figro3de10ipc8uanlhklpq": "A strong element with these children: important text, usually bold.",
"@g59jtaoocharinu0g61s5a93gt": "The same element with this id.",
"@hpfkhi91rc6vqo5mik83f807kr": "A label element with these children: a label for a field.",
"@l1ibnd69fhv5j8j3reredg1ar1": "A style sheet rule: a selector and its declarations. A style sheet is a list of these, so it shows rule by rule instead of as one long text.",
"@mu6u01fqm7u8ggvaacd7ft8vnv": "The same element with these attributes added after its own. Text and parts have no attributes, so they come back as they are.",
"@p5ns5c2at9rsn7a074sabhoe2l": "A footer element with these children: the page's foot.",
"@qm5t05logqs462j15o123n982b": "An attribute whose value doesn't change.",
"@r5b35ig7qeakhn17rfhe5icdum": "A button with this label that runs then when it's clicked.",
"@rm4i3ngd6i2lm0tmqffbav162l": "A section element with these children: a part of the page.",
"@rrc61bud51hgr319omhcik166b": "The texts with between between each two of them.",
"@rv4003uis8aho96iket351hfe2": "The same element in this class, for a style sheet's rules to select.",
"@sjob14735bluvs6m7b5jk0390s": "The same element with this inline style (CSS declarations, such as color: #777; margin: 0).",
"@sn4gh78ag6m7d62bhqfaa0tobd": "A h2 element with these children: a second-level heading.",
"@u3srrk2kepolp5pnrp35djmce7": "A li element with these children: one item of a list.",
"@uan4qmoeteetvco090nismatv9": "A h1 element with these children: the biggest heading.",
"@urmvgd3e2dcctt7q85g15nql15": "Rules that apply only when the query holds, such as (prefers-color-scheme: dark).",
"@v4m3u10hkehjb5097mejohqi5p": "A length in pixels, from a Float64 or an Int."
},
