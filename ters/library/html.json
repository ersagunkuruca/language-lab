"comments": {
"@0dgeiachcn1qr19gf446992srp": "A section element with these children: a part of the page.",
"@4jgbaf1nm0auc0ra9ntidrvata": "A div with these children. To give it attributes, wrap it: styled, classed, with.",
"@5mvgrb61q9cegn2c1sm4napr5i": "An element with these children, for a tag that has no function of its own here (main, nav, table, …). Each tag a function, as in Elm's Html module (prior art).",
"@7heqobbl291c6lk29o7egoc39q": "The same element in this class, for a style sheet's rules to select.",
"@a0jgvbkm5ne4i2vcjj1hcvvetc": "The same element with these attributes added after its own. Text and parts have no attributes, so they come back as they are.",
"@ak89sp66u6fcmghamq9aun64jd": "A label element with these children: a label for a field.",
"@crv72mh4alar7ubdsb6mqdomni": "The same element with this inline style (CSS declarations, such as color: #777; margin: 0).",
"@doueged5i4o5n86kau242gap09": "A span element with these children: a run of text inside a line.",
"@emf64e3th7qeq1i84n2nuht1hu": "A strong element with these children: important text, usually bold.",
"@hb0anq2n9mi88h5ajn89m5n9dn": "The same element with this id.",
"@hlqn389hehf52ofmtfa1c3daj9": "Text that doesn't change. Text that does is text(() => …), which the page runs again when what it reads changes.",
"@kr49d0a368fgb89ej0o6f2vig9": "An input field: it has attributes and no children.",
"@kunlo31nta5jjt6ih37vsduul5": "A h2 element with these children: a second-level heading.",
"@l1ibnd69fhv5j8j3reredg1ar1": "A style sheet rule: a selector and its declarations. A style sheet is a list of these, so it shows rule by rule instead of as one long text.",
"@l4fltpu2dl81aeikosc5mcdco6": "A button with this label that runs then when it's clicked.",
"@l86b1o08mvfoecpg2mfkjc40qn": "A style element holding these rules.",
"@mt78u3f4ui9u272qopcr2ap45o": "A p element with these children: a paragraph.",
"@n0gq7h2r89ueudnftg3bg89jo8": "A li element with these children: one item of a list.",
"@nkgva57jrii26radgf8hbh76e0": "A footer element with these children: the page's foot.",
"@nsj6g81j9sductn9gkvl3i5015": "The items of a cell's list, each drawn by row and all put inside (ul, div, …). An item still there when the list changes keeps its row as it was; only new items get one. Solid's <For> (prior art).",
"@rrc61bud51hgr319omhcik166b": "The texts with between between each two of them.",
"@sl3numdcpchti5aajnca8b08h3": "A ul element with these children: a list with bullets, whose items are li.",
"@u9o20rmbhfrh4t5cu5a65pdtuv": "An attribute whose value doesn't change.",
"@urmvgd3e2dcctt7q85g15nql15": "Rules that apply only when the query holds, such as (prefers-color-scheme: dark).",
"@v3p6j395r1hr0sq8kui9fpadnr": "A h1 element with these children: the biggest heading.",
"@v4m3u10hkehjb5097mejohqi5p": "A length in pixels, from a Float64 or an Int."
},
